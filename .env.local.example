# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_ENABLED=true
# Muestra cuentas demo en /login (usuarios creados por docker/postgres/init/02-seed.sql)
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true
# Si true, el registro copia campos demo (hackathon). Prod: false → wizard /onboarding
SEED_DEMO_ON_REGISTER=false

# === Postgres (Docker) ===
DATABASE_URL=postgresql://doctorsoya:doctorsoya@localhost:5433/doctorsoya
AUTH_SECRET=change-me-in-production

# === MinIO (Docker) ===
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=observations
STORAGE_PROVIDER=minio

# === Copernicus Data Space (API satélite S1/S2/S3 — Doctor Soya) ===
# IMPORTANTE: copernicuslac-panama.eu es formación/Moodle/VTE, NO emite OAuth.
# Registro API aparte: https://dataspace.copernicus.eu/
# Dashboard Sentinel Hub → User Settings → OAuth clients → Create
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# Instance ID para capas OGC WMS/WMTS (opcional, dashboard CDSE)
COPERNICUS_INSTANCE_ID=
SATELLITE_PROVIDER=copernicus

# === Sentinel Hub comercial (fallback opcional) ===
# https://www.sentinel-hub.com/
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# === NASA FIRMS (incendios / hotspots) ===
# Registro gratis: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_MAP_KEY=
FIRMS_ALERT_RADIUS_KM=5

# === Open-Meteo (clima + humedad suelo) ===
# Gratis sin key; OPEN_METEO_API_KEY solo para uso comercial
# https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=

# === IA diagnóstico de cultivos ===
VISION_PROVIDER=openai
OPENAI_API_KEY=sk-your-key
MISTRAL_API_KEY=

# === Cloudinary (CDN fotos observaciones, opcional) ===
# https://cloudinary.com/
STORAGE_PROVIDER=minio
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=doctor-soya

# === Web Push (VAPID) ===
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@doctorsoya.app

# === Cron (protege /api/cron/fetch-metrics) ===
CRON_SECRET=change-me-in-production

# === C3S Climate Data Store ===
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# === Twilio WhatsApp ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_SECRET=

# === VPS / Worker ===
DOMAIN=app.example.com
REDIS_URL=redis://redis:6379
WORKER_SECRET=
INTERNAL_API_SECRET=
APP_URL=http://localhost:3000

# === Geo-Data (Data-Historica, stub — off por defecto) ===
GEODATA_ENABLED=false
GEODATA_BASE_URL=http://localhost:8000
GEODATA_API_KEY=

# === Science Lab ===
SCIENCE_ALGORITHM_VERSION=1.0.0
ML_MODEL_PATH=./models/soybean_rf_v1.json
ML_ENABLED=true
SCIENCE_BATCH_CRON=0 2 * * *
# ML_REMOTE_URL=https://your-modal-app.modal.run/predict
SCIENCE_DATA_API_URL=
SCIENCE_DATA_API_KEY=
SCIENCE_DATA_API_MAPPING={"itemsPath":"data","crop":"crop","fieldId":"field_id","capturedAt":"captured_at","diseaseLabel":"disease_label","severity":"severity"}

# Opcional: rechazar grillas/tendencias sintéticas cuando hay CDSE
# SATELLITE_STRICT=true
# Obligatorio cambiar antes de deploy público:
# AUTH_SECRET=<openssl rand -hex 32>
# CRON_SECRET=<openssl rand -hex 32>
# WORKER_SECRET=<mismo que CRON_SECRET recomendado>
# NEXT_PUBLIC_APP_URL=https://app.tudominio.com
# NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=false
# DATABASE_URL=postgresql://user:pass@postgres:5432/doctorsoya
